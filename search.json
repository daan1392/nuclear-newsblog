---
permalink: /search.json
---
[
{%- for post in site.posts -%}
{"id": {{ forloop.index0 }}, "title": {{ post.title | jsonify }}, "url": {{ post.url | relative_url | jsonify }}, "date": {{ post.date | date: "%-d %b %Y" | jsonify }}, "category": {{ post.categories.first | jsonify }}, "tags": {{ post.tags | join: " " | jsonify }}, "countries": {{ post.countries | join: " " | jsonify }}, "excerpt": {{ post.excerpt | strip_html | strip | jsonify }}, "body": {{ post.content | strip_html | strip_newlines | truncate: 700 | jsonify }}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
